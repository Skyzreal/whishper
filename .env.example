# Liste des membres de la famille, séparés par des virgules (au moins deux). L'ordre est celui de l'affichage.
# Les accents et les majuscules n'ont pas d'importance à la connexion (« stephanie » fonctionne pour Stéphanie).
FAMILY_MEMBERS=Stéphanie,Michaël,Nathaniel,Jade,Marie,Stéphane,Orélie,François,Mélanie

# Le code secret que tout le monde entre pour se connecter.
FAMILY_PASSCODE=change-me

# Longue chaîne aléatoire servant à signer les cookies de connexion. Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Base de données. Laisse vide pour utiliser un fichier SQLite local (data/whishper.db).
# En production, utilise une base Turso gratuite (https://turso.tech) :
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=your-token

# Port pour `npm start` / `npm run dev:api` (3000 par défaut)
# PORT=3000

# Comma-separated list of family members (at least two). Order is how they appear in the app.
FAMILY_MEMBERS=Alice,Bob,Carol,Dave

# The shared passcode everyone enters to sign in.
FAMILY_PASSCODE=change-me

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Database. Leave unset for a local SQLite file at data/whishper.db.
# In production use a free Turso database (https://turso.tech):
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=your-token

# Port for `npm start` / `npm run dev:api` (default 3000)
# PORT=3000

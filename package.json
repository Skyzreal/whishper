{
  "name": "whishper",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "start": "tsx server/main.ts",
    "reset-password": "tsx server/reset-password.ts",
    "test": "npm run test:api && npm run test:web",
    "test:api": "vitest run --config server/vitest.config.mts",
    "test:web": "ng test --no-watch",
    "typecheck": "tsc -p tsconfig.server.json"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@libsql/client": "^0.18.0",
    "express": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
